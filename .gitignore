# Build outputs. The bootstraps are release assets, not committed files:
# bootstrap-aarch64-slim.zip is 42MB and bootstrap-arm-slim.zip is 40MB, and
# stock-*.zip is another 33MB and 30MB of input. All four belong outside git
# history; build-all.sh regenerates them.
bootstrap-*-slim.zip
stock-*.zip

# termux-main package indexes, 1.8MB each and refreshed by build-slim-bootstrap.sh
# when missing. Committed only so a rerun is reproducible; delete these lines if
# you would rather always fetch the current index.
Packages
Packages-*

# Scratch trees and deb caches.
build/
build-*/
.ex/
ex-*/
.exscratch/
.deb-cache/
*.deb

# Extracted stock tree, used by test-plan.sh and test-bootstrap.sh to compare
# against the stock baseline. Regenerated by unzipping stock-*.zip.
ex/
ex-*/

# Scratch tree from an early manual run of add-packages.sh, and python bytecode.
testroot/
__pycache__/
*.pyc

# APK build workspace and output. apk-work/ is ~600MB of downloaded artifacts,
# extracted AARs and compiled resources; apk/ is the built APK at ~86MB. Both are
# regenerated by build-apk.sh.
apk/
apk-work/

# The bootstrap zips the APK embeds. build-apk.sh looks for them here first and
# falls back to termux-app/app/src/main/cpp/.
slim/
